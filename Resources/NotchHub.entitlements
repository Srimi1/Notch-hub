<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Media transport (Music/Spotify) and the Focus toggle drive other apps
         through NSAppleScript. The hardened runtime blocks Apple Events unless
         this entitlement is present, so signing without it silently breaks both.
         This is the app's ONLY entitlement. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
