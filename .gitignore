# Swift Package Manager / build artifacts
.build/
.swiftpm/
Package.pins

# Built app bundle (do not commit binaries)
*.app/
*.dmg
dist/

# Xcode
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/

# macOS
.DS_Store

# Secrets / local config (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.secret
*.token
config.json
credentials.json
service-account.json
secrets.json
local_config.json

# SSH, cloud and package-registry credentials
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
.ssh/
.aws/
.gcloud/
.npmrc
.pypirc
.netrc

# Signing and notarization material (Developer ID builds)
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.entitlements.local

# Backups and dumps (can contain real data)
*.backup
*.bak
*.sql
*.dump

# Local tooling / agent scratch (not app source)
.claude-flow/
.commandcode/
.claude/settings.local.json
memory/
*.memory
private_prompts/
*.db
*.sqlite
*.log
.cache/
ChatGPT Image*.png

# Internal dev/planning docs (kept local, not published)
CLAUDE.md
AGENTS.md
PROGRESS.md
docs/PROJECT_STATUS_REPORT.md

# Local audit output (not published)
audit-report.md

# Release notes are drafted locally until published
docs/RELEASE_NOTES_*.md
